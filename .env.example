# ============================================================
# CryptoForge — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore
# ============================================================

# -------- Database (local dev) --------
DB_USERNAME=root
DB_PASSWORD=cryptoforge
DATABASE_URL=jdbc:mysql://localhost:3306/cryptoforge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# -------- Database (production — from Railway/PlanetScale dashboard) --------
# DATABASE_URL=jdbc:mysql://HOST:PORT/cryptoforge?useSSL=true&serverTimezone=UTC
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_strong_password

# -------- JWT Secret (min 32 characters) --------
JWT_SECRET=ReplaceThisWithA32PlusCharacterSecretKey!

# -------- Spring Profile --------
# local dev: leave blank or set to 'default'
# production: set to 'prod'
SPRING_PROFILES_ACTIVE=prod

# -------- Server Port --------
# Render injects PORT automatically — only set for local
PORT=8080

# -------- Where to set these for deployment --------
# Render:   Dashboard → Your Service → Environment
# Railway:  Dashboard → Project → Variables
# Vercel:   Dashboard → Project → Settings → Environment Variables
